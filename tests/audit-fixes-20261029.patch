+  ['仅通用口令', [auditConfirmHead + '就这样跑'], '通过'],
+  ['异票', [auditConfirmHead + '票 2 验收单确认'], '不通过'],
+  ['异票混通用', [auditConfirmHead + '票 2 验收单确认，就这样跑'], '不通过'],
+  ['同票混异票', [auditConfirmHead + '票 1 验收单确认；票 2 验收单确认'], '不通过'],
+  ['无确认', [], '不通过'],
+  ['错版', ['- 第 1 次确认（第 2 版）：2026-09-27｜票 1 验收单确认'], '不通过'],
+]) test('审计2-明确确认票号-' + label, () => {
+  const c = coach(), body = ticket({ versions: [GOOD], confirms }), p = ticketProject(c, body);
+  const before = snap(p);
+  const [verdict, text] = check(c, p, 'accept', ['01']);
+  assert.equal(verdict, want, label + '\n' + text);
