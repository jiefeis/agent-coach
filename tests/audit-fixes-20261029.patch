+// ---------- 审计20261029：真实边界、票号、图源隔离及诊断未核；只用既有夹具与命令 ----------
+for (const linked of [false, true]) test('审计1-普通材料与安全项目内材料联接-' + (linked ? '联接' : '普通'), () => {
+  const c = coach(), p = ready(c, 1);
+  if (linked) {
+    fs.renameSync(path.join(p, 'materials'), path.join(p, 'vault'));
+    fs.symlinkSync(path.join(p, 'vault'), path.join(p, 'materials'), 'junction');
+  }
+  const rel = 'materials/样例-周报.csv', before = fs.readFileSync(path.join(p, rel));
+  const r = run(c, ['init', p]);
+  assert.equal(r.code, 0, r.err);
+  assert.match(first(result(p, 'init')), /｜通过$/);
+  assert.deepEqual(fs.readFileSync(path.join(p, rel)), before, '正常布局也必须保持材料原字节');
+});
+
+test('审计1-材料与报告双联接不得覆写材料原件', () => {
+  const c = coach(), p = ready(c, 1), vault = path.join(p, 'vault');
+  fs.renameSync(path.join(p, 'materials'), vault);
+  fs.symlinkSync(vault, path.join(p, 'materials'), 'junction');
+  fs.rmSync(path.join(p, 'docs', 'check'), { recursive: true });
+  fs.symlinkSync(vault, path.join(p, 'docs', 'check'), 'junction');
+  const original = Buffer.from('ORIGINAL MATERIAL\n', 'utf8'), material = path.join(vault, 'init.txt');
+  fs.writeFileSync(material, original);
+  const r = run(c, ['init', p]);
+  assert.deepEqual(fs.readFileSync(material), original, '报告路径的别名不能写穿材料真实根');
+  assert.notEqual(r.code, 0, '双联接的材料报告目标必须被拒绝');
+});
+
+for (const top of ['work', 'output']) test('审计1-材料真实根位于' + top + '时不能列为产出', () => {
+  const c = coach(), p = example(c), vault = path.join(p, top, '02-材料库');
+  fs.mkdirSync(path.dirname(vault), { recursive: true });
+  fs.renameSync(path.join(p, 'materials'), vault);
+  fs.symlinkSync(vault, path.join(p, 'materials'), 'junction');
+  const originals = fs.readdirSync(vault).map((n) => [n, fs.readFileSync(path.join(vault, n))]);
+  const output = top + '\\02-材料库\\02-汇总.csv';
+  put(p, 'docs/run-flow.md', swap(RF, /work\\02-汇总\.csv/g, output));
+  const [verdict, text] = check(c, p, 'flow');
+  for (const [n, bytes] of originals) assert.deepEqual(fs.readFileSync(path.join(vault, n)), bytes, n);
+  assert.equal(verdict, '不通过', '即使真实根在输出目录，材料仍只读\n' + text);
+  assert.match(text, /^✗ .*materials|^✗ .*材料/m, text);
+});
