+const auditTicketRel = 'docs/tickets/01-认出输入.md';
+for (const [label, field, value] of [
+  ['编号与具体样例路径', '从哪拿', 'materials\\价格日报-2026-W38.csv、materials\\价格日报-2026-W37.csv'],
+  ['编号混合路径', '从哪拿', '输入 1、materials\\价格日报-2026-W37.csv'],
+  ['非空措辞差异', '做什么', '认出输入：照已确认清单选择本周及上周日报；缺栏目先询问。依据：输入清单'],
+]) test('审计4-差异未证等价须显式未核-' + label, () => {
+  const c = coach(), p = sample('教练做的-完成-对照');
+  assert.ok(fs.existsSync(path.join(p, 'materials', '价格日报-2026-W38.csv')));
+  assert.ok(fs.existsSync(path.join(p, 'materials', '价格日报-2026-W37.csv')));
+  put(p, auditTicketRel, swap(read(p, auditTicketRel), new RegExp('^' + field + '：.*$', 'm'), field + '：' + value));
+  const [sec] = secOf(c, p, '## 长期记忆'), lines = only(sec, '①');
+  const difference = lines.filter((l) => l.includes('票 01') && l.includes(field));
+  assert.ok(difference.some((l) => l.startsWith('· ') && l.includes('未核')), '无法证明对应关系的差异必须列未核\n' + sec);
+  assert.ok(!difference.some((l) => l.startsWith('✗ ')), '不能只凭字面差异判业务错误\n' + sec);
+  assert.doesNotMatch(lines.join('\n'), /^✓ .*票 01.*三格.*一致/m, '有未核差异不能输出一致\n' + sec);
+  assert.ok(difference.join('\n').includes(value), '须列本票的实际值供补证\n' + sec);
+  assert.match(difference.join('\n'), /docs\\tickets\\01-认出输入\.md/, '须列票的来源位置\n' + sec);
+  assert.match(difference.join('\n'), /docs\\run-flow\.md/, '须列运行表的来源位置\n' + sec);
+});
