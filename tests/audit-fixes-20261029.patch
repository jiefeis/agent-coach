+function auditPictureProject(c) {
+  const p = sample('教练做的-完成-对照');
+  assert.equal(check(c, p, 'flow')[0], '通过');
+  put(p, 'docs/PROJECT_INDEX.md', swap(read(p, 'docs/PROJECT_INDEX.md'), /^当前站：.*$/m, '当前站：4'));
+  put(p, 'AGENTS.md', swap(read(p, 'AGENTS.md'), '共 3 步', '共 99 步'));
+  return p;
+}
+test('审计3-站4有效图源控制例保留独立内容诊断', () => {
+  const c = coach(), p = auditPictureProject(c);
+  const [picture, report] = secOf(c, p, '## 给人看的图');
+  assert.match(picture, /^✓ 图源与运行表一致/m, picture);
+  assert.match(report, /^✗ 内容②：.*99.*3/m, '已触达图源比较且另一项真实问题仍被列出\n' + report);
+});
+for (const [label, malformed] of [
+  ['顶层null', () => null],
+  ['旧形状节点null', () => ({ nodes: [null], edges: [], phases: [], lanes: [] })],
+]) test('审计3-站4错误图源只损坏本项-' + label, () => {
+  const c = coach(), p = auditPictureProject(c), valid = JSON.parse(read(p, J));
+  put(p, J, JSON.stringify(malformed(valid)) + '\n');
+  const [picture, report] = secOf(c, p, '## 给人看的图');
+  assert.ok(marks(picture, '✗').length > 0, '结构错误应局限在图小节，而非吞掉整单诊断\n' + picture);
+  assert.doesNotMatch(picture, /^✓ 图源与运行表一致/m, picture);
+  assert.match(report, /^✗ 内容②：.*99.*3/m, '图源坏了仍须保留独立诊断\n' + report);
+});
