+  assert.match(end, /采用.{0,8}升站[\s\S]*files[\s\S]*通过/);
+  assert.match(end, /停止.*立即.*(?:files|accept)/);
+  assert.match(end, /记录失败.*不恢复执行/);
+  assert.match(end, /不(?:写虚假|记)完成/);
+});
+
+test('审计5-收尾停止立即生效且采用仍守原门', () => {
+  const end = section(read(PRODUCT, '做法/5-收尾交接.md'), '## 6 过关');
+  assert.match(end, /["“]停止["”]：.*立即/);
+  assert.match(end, /记录失败.*不恢复执行/);
+  assert.match(end, /决定.*范围.*未完/);
+  assert.match(end, /["“]采用["”]：[\s\S]*accept 01[\s\S]*files 5[\s\S]*通过.*搭建完成/);
+  assert.match(end, /已结束（停止）/);
+});
