+test('审计7-开发验收与交接README指导保留每次必核和新版确认', () => {
+  const development = section(read(PRODUCT, '做法/4-一步一票.md'), '## 3 核齐验收三要素');
+  const handoff = section(read(PRODUCT, '做法/5-收尾交接.md'), '## 3 填全 README');
+  for (const text of [development, handoff]) {
+    assert.match(text, /固定回归/);
